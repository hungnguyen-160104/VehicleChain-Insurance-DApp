# ============================================================
# Sao chép thành .env.local và điền giá trị thật
# cp .env.example .env.local
# ============================================================

# WalletConnect — https://cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# Network
NEXT_PUBLIC_NETWORK=localhost
NEXT_PUBLIC_NETWORK_CHAINID=1337

# Contract Addresses (sau khi deploy Hardhat)
NEXT_PUBLIC_CONTRACT_ADDRESS_LOCALHOST=0x...

# RPC URLs
NEXT_PUBLIC_LOCALHOST_RPC=http://127.0.0.1:8545
NEXT_PUBLIC_HOLESKY_RPC=https://rpc.ankr.com/eth_holesky/

# Pinata IPFS — https://pinata.cloud
# CHỈ dùng phía server (Next.js API route /api/ipfs/*), KHÔNG dùng tiền tố
# NEXT_PUBLIC_ để tránh lộ key ra client bundle.
PINATA_JWT=your_pinata_jwt

# App Info
NEXT_PUBLIC_APP_NAME=Vehicle Insurance DApp
NEXT_PUBLIC_APP_DESCRIPTION=Decentralized Vehicle Insurance Platform on Blockchain

# AI Service URL
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
