# ============================================================
# Next.js .gitignore
# ============================================================

# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Next.js
/.next/
/out/

# Production build
/build

# ─── ENV FILES — QUAN TRỌNG ──────────────────────────────────
# Chứa Pinata JWT, WalletConnect Project ID
.env.local
.env*.local
.env

# Chỉ giữ file mẫu (không có giá trị thật)
!.env.example

# ─── Misc ────────────────────────────────────────────────────
.DS_Store
*.pem
.vercel

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
