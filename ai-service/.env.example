# ============================================================
# Sao chép file này thành .env và điền giá trị thật
# cp .env.example .env
# ============================================================

# Gemini API Key — lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Đăng nhập quản trị bằng CHỮ KÝ VÍ owner (không còn username/password).
# Đặt = địa chỉ ví owner của smart contract (deployer). Chỉ ví này mới đăng nhập được.
# Mặc định localhost = Hardhat account #0.
OWNER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# JWT Config — đổi thành chuỗi ngẫu nhiên mạnh trước khi deploy
JWT_SECRET_KEY=your_random_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Paths (giữ nguyên mặc định)
CHROMA_DB_PATH=./data/chroma_db
UPLOADS_PATH=./data/uploads
DOCUMENTS_JSON=./data/documents.json
