# ============================================================
# ai-service/.dockerignore
# ============================================================

# Secrets — NEVER include in Docker image
.env

# Generated data — mount as volume instead
data/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Virtual environment
venv/
.venv/
env/

# IDE
.vscode/
.idea/

# Git
.git/
.gitignore

# Docs
*.md
