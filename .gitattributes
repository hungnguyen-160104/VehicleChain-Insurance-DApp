# Auto detect text files and perform LF normalization
* text=auto

# JavaScript / TypeScript
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Python
*.py    text eol=lf

# Solidity
*.sol   text eol=lf

# Config files
*.yml   text eol=lf
*.yaml  text eol=lf
*.env*  text eol=lf
*.txt   text eol=lf
*.css   text eol=lf

# Binary files
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.pdf   binary
